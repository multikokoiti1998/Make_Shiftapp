<Window x:Class="Shiftapp_demo.Views.CompOffDutyPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="代休の紐づけ先を選択"
        Height="360" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="この代休をどの当直/日勤に紐づけますか？"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <ListBox x:Name="CandidateListBox"
                 Grid.Row="1"
                 DisplayMemberPath="Label"
                 MouseDoubleClick="CandidateListBox_MouseDoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="80" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="OK" Width="80" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
